# Set these values in the Windows service environment. Do not commit real credentials.
PING_PRINTER_MODE=file
PING_PRINTER_NAME=StarTSP100
PING_DATABASE=storage/ping.sqlite
PING_UPLOAD_PATH=storage/uploads
PING_OUTPUT_PATH=storage/print-output
PING_PRINTER_WIDTH=512
PING_MAX_MESSAGE_LENGTH=1024
PING_MAX_IMAGE_BYTES=5242880
PING_MAX_IMAGE_PIXELS=20000000
PING_RATE_LIMIT=10
PING_RATE_WINDOW=60
PING_TIMEZONE=America/New_York
